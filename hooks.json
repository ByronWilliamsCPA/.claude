{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/bash-pre-hook.sh",
          "timeout": 10,
          "statusMessage": "Checking Bash command safety..."
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/sensitive-file-guard.sh",
          "timeout": 5,
          "statusMessage": "Checking for sensitive file edits..."
        }
      ]
    },
    {
      "matcher": "Skill",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/planning-bridge-gate.sh"
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python3 $HOME/dev/.claude/.submodules/anthropics-plugins/plugins/security-guidance/hooks/security_reminder_hook.py",
          "timeout": 10,
          "statusMessage": "Checking for security patterns..."
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "CLAUDE_PLUGIN_ROOT=$HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify python3 $HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify/hooks/pretooluse.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/destructive-command-guard.sh",
          "timeout": 10,
          "statusMessage": "Checking for destructive command patterns..."
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "(Edit|Write)",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/py310-compat-check.sh"
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/snyk-dep-reminder.sh",
          "timeout": 5,
          "statusMessage": "Checking dependency manifest changes..."
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/test-skip-guard.sh",
          "timeout": 5,
          "statusMessage": "Checking for test-skip/ignore markers..."
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "CLAUDE_PLUGIN_ROOT=$HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify python3 $HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify/hooks/posttooluse.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python3 $HOME/.claude/scripts/hooks/delegation-ratio-nudge.py",
          "timeout": 5,
          "statusMessage": "Checking main-thread delegation ratio..."
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "CLAUDE_PLUGIN_ROOT=$HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify python3 $HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify/hooks/stop.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/scripts/hooks/task-observer-flush-check.py",
          "timeout": 10
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/precompact-handoff.sh",
          "timeout": 10,
          "statusMessage": "Capturing auto-handoff snapshot before compaction..."
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/cbm-context-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/delegation-reminder.sh",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/task-observer-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/handoff-resume-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/harness-doctor.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "resume",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/cbm-context-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/delegation-reminder.sh",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/task-observer-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/handoff-resume-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/harness-doctor.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "clear",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/cbm-context-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/delegation-reminder.sh",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/task-observer-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/handoff-resume-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/harness-doctor.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "compact",
      "hooks": [
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/cbm-context-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/delegation-reminder.sh",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/task-observer-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/hooks/handoff-resume-reminder.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "bash $HOME/.claude/scripts/harness-doctor.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "CLAUDE_PLUGIN_ROOT=$HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify python3 $HOME/dev/.claude/.submodules/anthropics-plugins/plugins/hookify/hooks/userpromptsubmit.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/scripts/pr-review-reminder.py",
          "timeout": 5,
          "statusMessage": "Checking for PR review intent..."
        },
        {
          "type": "command",
          "command": "python3 $HOME/.claude/scripts/session-length-nudge.py",
          "timeout": 5,
          "statusMessage": "Checking session length..."
        }
      ]
    }
  ]
}
