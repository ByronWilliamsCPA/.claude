# MCP Server Environment Variables
# Copy this file to ~/.bashrc or ~/.zshrc and update with your actual values

# =============================================================================
# Tier 1 Servers (Always Loaded)
# =============================================================================

# GitHub MCP Server - REQUIRED
# Get token from: https://github.com/settings/tokens
# Or via: gh auth token
export GITHUB_PERSONAL_ACCESS_TOKEN="your_github_token_here"

# Zen MCP Server - No environment variables required
# Context7 - No environment variables required

# =============================================================================
# Tier 2/3 Servers (On-Demand)
# =============================================================================

# Postgres MCP Server - OPTIONAL (only if using database features)
# Format: postgresql://user:password@host:port/database
# Example for local: postgresql://postgres:postgres@localhost:5432/mydb
# Example for VM: postgresql://postgres:postgres@192.168.1.16:5432/mydb
export DATABASE_URL="postgresql://user:password@host:5432/database"

# Sentry MCP Server - OPTIONAL (only if using error monitoring)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
export SENTRY_AUTH_TOKEN="your_sentry_auth_token_here"
export SENTRY_ORG="your_sentry_org_slug"

# UML MCP Server - OPTIONAL (output directory)
# Defaults to ~/.claude/tmp_cleanup/diagrams
export UML_OUTPUT_DIR="${HOME}/.claude/tmp_cleanup/diagrams"

# Playwright - No additional environment variables required (uses PLAYWRIGHT_HEADLESS=true by default)
# Docker Hub - No additional environment variables required
# Mermaid - No additional environment variables required

# =============================================================================
# Apply Environment Variables
# =============================================================================
# After updating this file with your values:
# 1. Source it: source ~/.bashrc (or ~/.zshrc)
# 2. Verify: echo $GITHUB_PERSONAL_ACCESS_TOKEN
# 3. Restart VS Code to pick up new environment variables
