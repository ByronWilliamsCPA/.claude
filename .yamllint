---
# yamllint configuration for Claude Code Configuration
extends: default

ignore: |
  .venv/
  node_modules/

rules:
  line-length:
    max: 120
    level: warning

  # Catch duplicate keys (yamllint 1.33 compatible; forbid-duplicated-merge-keys requires 1.35+)
  key-duplicates: enable

  # More lenient indentation for readability
  indentation:
    spaces: 2
    indent-sequences: true

  # Align with Qlty Cloud default: require 2 spaces before inline comments
  comments:
    require-starting-space: true
    min-spaces-from-content: 2

  # Allow longer lines in comments
  comments-indentation: {}

  # Disable document start requirement (---)
  document-start: disable
