{
  "permissions": {
    "allow": [
      "Bash(python3 $HOME/.claude/scripts/compliance_log_render.py:*)",
      "Bash(python3 $HOME/.claude/scripts/compliance_rollup_reconcile.py:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/bash-pre-hook.sh",
            "timeout": 10,
            "statusMessage": "Checking Bash command safety..."
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "(^|/)\\.env[^/]*$",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/env-file-audit.sh",
            "timeout": 10,
            "statusMessage": "Auditing .env file change..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/stop-pre-commit-hook.sh",
            "timeout": 120,
            "statusMessage": "Running pre-commit on touched files..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/bash-notify.sh",
            "timeout": 15,
            "statusMessage": ""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -rn 'datetime.UTC' --include='*.py' $CLAUDE_PROJECT_DIR && echo 'WARNING: datetime.UTC is Python 3.11+ only, use datetime.timezone.utc' >&2 || true",
            "timeout": 10,
            "statusMessage": "Checking Python 3.10 compatibility..."
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && ruff check --fix --target-version py310 $CLAUDE_FILE_PATH 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Running ruff auto-fix..."
          },
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.sh ]]; then shellcheck \"$CLAUDE_FILE_PATH\" 2>&1 || true; fi",
            "timeout": 15,
            "statusMessage": "Running shellcheck..."
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/validate-frontmatter.sh",
            "timeout": 10,
            "statusMessage": "Validating skill/agent frontmatter..."
          }
        ]
      }
    ]
  }
}
