{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sonarqube": {
      "type": "http",
      "url": "http://localhost:8090/mcp",
      "headers": {
        "Authorization": "Bearer ${SONARQUBE_TOKEN}"
      }
    },
    "pal": {
      "command": "/home/byron/dev/zen-mcp-server/.pal_venv/bin/python",
      "args": [
        "/home/byron/dev/zen-mcp-server/server.py"
      ],
      "cwd": "/home/byron/dev/zen-mcp-server"
    }
  }
}
