@startuml hook_pipeline
' Hook Pipeline — backs ADR-002.
' Shows the 5 hook types firing across a single conversation turn.

title Hook Pipeline — One Conversation Turn

skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam defaultFontName Roboto

actor User
participant "Claude Code" as CC
participant "hooks.json\n(via settings.json)" as Hooks
participant "hookify" as Hookify
participant "Project Gates\n(planning-bridge,\npy310-compat,\ntdd-enforce,\ntrack-mcp)" as Gates
participant "Tools\n(Edit/Write/Bash/...)" as Tools

User -> CC : prompt
activate CC

CC -> Hooks : UserPromptSubmit
Hooks -> Hookify : dispatch
Hooks -> Gates : keyword-tool-trigger.sh
Hooks --> CC : continue

CC -> CC : model turn
note right : Model reasons\nand decides tool calls

loop each tool call (Write, Edit, Bash, ...)
  CC -> Hooks : PreToolUse
  Hooks -> Gates : secrets scan
  Hooks -> Gates : py310-compat-check
  Hooks -> Gates : planning-bridge-gate
  Hooks -> Gates : tdd-enforcement
  Hooks -> Hookify : dispatch pretooluse
  Hooks --> CC : allow / block

  alt gates allow
    CC -> Tools : execute
    Tools --> CC : result
    CC -> Hooks : PostToolUse
    Hooks -> Gates : track-mcp-usage
    Hooks -> Hookify : dispatch posttooluse
    Hooks --> CC : continue
  else gate blocks
    CC --> User : blocked (with reason)
  end
end

CC --> User : response
CC -> Hooks : Stop
Hooks -> Hookify : dispatch stop
deactivate CC

note right of Hooks
  SessionStart fires once
  per session (not per turn),
  running keyword-tool-trigger
  --reset plus hookify
  sessionstart dispatch.
end note

@enduml
