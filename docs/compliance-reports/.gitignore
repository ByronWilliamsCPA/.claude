# Compliance aggregation state is local-only; synthesis/archive/fleet-actions are shared
# Ignore state files but keep the marker
/state/*
!/state/.gitkeep

# Per-repo audit artifacts when .claude itself is audited (local-only by policy)
/lessons-learned/
/fleet-actions/*.md
!/fleet-actions/.gitkeep

# Legacy session retrospectives migrated from docs/compliance-retrospectives/ (local-only)
/archive/sessions/*.md
!/archive/sessions/.gitkeep
