{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_permissionsTrialNote": "22-entry ask list added 2026-04-11. 7-day trial. Off-switch: set ask to [].",
  "permissions": {
    "allow": [
      "Bash(poetry run ruff:*)",
      "Bash(npx -y ccusage@20.0.9:*)",
      "Bash(curl -s http://127.0.0.1:4981/api/*)",
      "Bash(gh api -X POST repos/*/pulls/*/comments*)",
      "Bash(gh api -X POST repos/*/pulls/*/reviews*)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Task"
    ],
    "deny": [],
    "ask": [
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(docker run:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker system prune:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl drain:*)",
      "Bash(npm uninstall:*)",
      "Bash(pip uninstall:*)",
      "Bash(firebase deploy:*)",
      "Bash(gcloud:*)",
      "Bash(git push --force:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(git clone:*)"
    ]
  },
  "hooks": {},
  "mcpServers": {
    "zen": {
      "command": "${HOME}/dev/zen-mcp-server/.pal_venv/bin/python",
      "args": ["${HOME}/dev/zen-mcp-server/server.py"],
      "cwd": "${HOME}/dev/zen-mcp-server",
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@2.2.4"],
      "env": {}
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["zen", "context7", "github"],
  "feedbackSurveyState": {
    "lastShownTime": 1754083719175
  },
  "sandbox": {
    "enabled": false
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.19"
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "outputStyle": "explanatory",
  "plansDirectory": "~/.claude/plans",
  "extraKnownMarketplaces": {
    "agents-observe": {
      "source": {
        "source": "directory",
        "path": "/home/byron/dev/.claude/.submodules/agents-observe"
      }
    }
  },
  "enabledPlugins": {
    "agents-observe@agents-observe": true
  }
}
