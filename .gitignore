# Temporary reference files (anti-compaction strategy)
# Keep the directory, but ignore .tmp-* files inside it
tmp_cleanup/
!tmp_cleanup/.gitkeep

docs/content_reviews/
docs/audit-report.md

# Skill workspace and A/B test variant directories (not user-facing skills)
.claude/skills/*-workspace/
.claude/skills/*-workspace-r2/
.claude/skills/*-variant-b/
.claude/skills/*-variant-b-r2/

# Skill eval artifacts (r2 iteration files)
.claude/skills/**/evals/evals-r2.json

# Git worktrees (always project-local, never at global paths)
.worktrees/
# Defensive: also catch worktrees mistakenly created under .claude/. The
# CLAUDE.md global rule places worktrees at .worktrees/<branch-slug>; this
# entry guards against the .claude/worktrees/ pattern that has surfaced.
.claude/worktrees/

# PlantUML runtime artifacts (Java font cache written by plantuml CLI)
# The '?' pattern matches any single-char dir name that plantuml creates
docs/architecture/diagrams/?/

# Compliance reports (generated artifacts, not committed)
docs/compliance-reports/

# Troubleshooting notes (operational decisions, incident notes, living docs)
docs/troubleshooting/

# Local MCP server configuration (contains auth tokens and local paths)
.mcp.json

# Task Observer runtime data (gitignored; populated at runtime, never committed)
skill-observations/
skill-updates/

# GitHub repo catalog (contains private repo names; refresh manually with gh repo list)
docs/reference/github-repos.md
docs/reference/github-repos.json

# Branch-protection backup snapshots (created by Track 5 backup loop)
backups/
